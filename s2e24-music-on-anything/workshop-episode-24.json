 "triggerDefinitions": {
  "camp_music_on": {
   "name": "camp_music_on",
   "recurring": true,
   "conditions": [
    {
     "type": "party-area",
     "operator": "equals",
     "value": "The Show's Camp"
    },
    {
     "type": "read-boolean",
     "key": "camp_music",
     "operator": "equals",
     "value": false
    }
   ],
   "effects": [
    {
     "type": "music-track-set",
     "trackId": "Camp Theme"
    },
    {
     "type": "write-boolean",
     "key": "camp_music",
     "operator": "set",
     "value": true
    }
   ]
  },
  "camp_music_off": {
   "name": "camp_music_off",
   "recurring": true,
   "conditions": [
    {
     "type": "read-boolean",
     "key": "camp_music",
     "operator": "equals",
     "value": true
    },
    {
     "type": "party-area",
     "operator": "notEquals",
     "value": "The Show's Camp"
    }
   ],
   "effects": [
    {
     "type": "music-track-clear"
    },
    {
     "type": "write-boolean",
     "key": "camp_music",
     "operator": "set",
     "value": false
    }
   ]
  }
 }
